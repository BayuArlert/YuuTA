// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum DocumentType {
  JURNAL
  SKRIPSI
}

enum CitationStyle {
  APA
  IEEE
  VANCOUVER
}

enum SectionStatus {
  EMPTY
  DRAFT
  DONE
}

enum SectionKey {
  // Jurnal (IMRaD)
  INTRODUCTION
  METHODS
  RESULTS
  DISCUSSION
  // Skripsi
  BAB_I
  BAB_II
  BAB_III
  BAB_IV
  BAB_V
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?    // null jika login via OAuth
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts   Account[]
  sessions   Session[]
  documents  Document[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Document {
  id            String        @id @default(cuid())
  userId        String
  title         String
  topic         String        @db.Text
  documentType  DocumentType
  citationStyle CitationStyle @default(APA)
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections   Section[]
  outlines   Outline[]
  references Reference[]

  @@map("documents")
}

model Section {
  id           String        @id @default(cuid())
  documentId   String
  sectionKey   SectionKey
  title        String
  orderIndex   Int
  status       SectionStatus @default(EMPTY)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  drafts   SectionDraft[]

  @@unique([documentId, sectionKey])
  @@map("sections")
}

model SectionDraft {
  id             String   @id @default(cuid())
  sectionId      String
  content        String   @db.Text
  aiFeedback     String?  @db.Text
  guidedAnswers  Json?    // JSON object: { questionId: answer }
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("section_drafts")
}

model Outline {
  id               String   @id @default(cuid())
  documentId       String
  generatedOutline Json     // Structured JSON per section
  isEdited         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("outlines")
}

model Reference {
  id                 String   @id @default(cuid())
  documentId         String
  rawText            String   @db.Text
  formattedApa       String?  @db.Text
  formattedIeee      String?  @db.Text
  formattedVancouver String?  @db.Text
  isCited            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("references")
}
